+static Uint32 Emscripten_GetRumbleCapabilities(SDL_joylist_item *item)
+{
+    Uint32 capabilities;
+
+    if (!item) {
+        return 0;
+    }
+
+    capabilities = (Uint32)MAIN_THREAD_EM_ASM_INT({
+        var gamepad = navigator['getGamepads']()[$0];
+        var actuator = gamepad && gamepad['vibrationActuator'];
+        var result = 0;
+
+        if (!actuator || typeof actuator['playEffect'] !== 'function') {
+            return result;
+        }
+
+        var effects = actuator['effects'];
+        if (!effects || effects['includes']('dual-rumble') || effects['includes']('trigger-rumble')) {
+            result |= $1;
+        }
+        if (effects && effects['includes']('trigger-rumble')) {
+            result |= $2;
+        }
+        return result;
+    }, item->index, SDL_JOYCAP_RUMBLE, SDL_JOYCAP_RUMBLE_TRIGGERS);
+
+    item->rumble_available = (capabilities & SDL_JOYCAP_RUMBLE) != 0;
+    item->trigger_rumble_available = (capabilities & SDL_JOYCAP_RUMBLE_TRIGGERS) != 0;
+    return capabilities;
+}
+
+static int Emscripten_UpdateRumble(SDL_joylist_item *item)
+{
+    int result = MAIN_THREAD_EM_ASM_INT({
+        var gamepad = navigator['getGamepads']()[$0];
+        if (!gamepad || !gamepad['vibrationActuator']) {
+            return -1;
+        }
+
+        try {
+            var actuator = gamepad['vibrationActuator'];
+            var type = actuator['effects'] && actuator['effects']['includes']('trigger-rumble')
+                ? 'trigger-rumble' : 'dual-rumble';
+            var effect = actuator['playEffect'](type, {
+                'startDelay': 0,
+                'duration': 3000,
+                'weakMagnitude': $1 / 0xFFFF,
+                'strongMagnitude': $2 / 0xFFFF,
+                'leftTrigger': $3 / 0xFFFF,
+                'rightTrigger': $4 / 0xFFFF
+            });
+            if (effect && effect['catch']) {
+                effect['catch'](function() {});
+            }
+            return 0;
+        } catch (error) {
+            return -1;
+        }
+    }, item->index, item->weak_magnitude_rumble, item->strong_magnitude_rumble,
+       item->left_trigger_rumble, item->right_trigger_rumble);
+    if (result < 0) {
+        return SDL_SetError("Browser gamepad rumble failed");
+    }
+    return result;
+}
