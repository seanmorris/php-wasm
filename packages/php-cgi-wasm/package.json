{
  "name": "php-cgi-wasm",
  "version": "0.1.0",
  "description": "php-cgi for wasm.",
  "main": "./PhpCgiNode.js",
  "module": "./PhpCgiNode.mjs",
  "types": "./PhpCgiNode.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./PhpCgiNode.d.mts",
        "default": "./PhpCgiNode.mjs"
      },
      "require": {
        "types": "./PhpCgiNode.d.cts",
        "default": "./PhpCgiNode.js"
      },
      "default": "./PhpCgiNode.mjs"
    },
    "./package.json": "./package.json",
    "./public": {
      "types": "./public.d.ts",
      "default": "./public.d.ts"
    },
    "./PhpCgiBase": {
      "import": {
        "types": "./PhpCgiBase.d.mts",
        "default": "./PhpCgiBase.mjs"
      },
      "require": {
        "types": "./PhpCgiBase.d.cts",
        "default": "./PhpCgiBase.js"
      },
      "default": "./PhpCgiBase.mjs"
    },
    "./PhpCgiNode": {
      "import": {
        "types": "./PhpCgiNode.d.mts",
        "default": "./PhpCgiNode.mjs"
      },
      "require": {
        "types": "./PhpCgiNode.d.cts",
        "default": "./PhpCgiNode.js"
      },
      "default": "./PhpCgiNode.mjs"
    },
    "./PhpCgiWebBase": {
      "import": {
        "types": "./PhpCgiWebBase.d.mts",
        "default": "./PhpCgiWebBase.mjs"
      },
      "require": {
        "types": "./PhpCgiWebBase.d.cts",
        "default": "./PhpCgiWebBase.js"
      },
      "default": "./PhpCgiWebBase.mjs"
    },
    "./PhpCgiWorker": {
      "import": {
        "types": "./PhpCgiWorker.d.mts",
        "default": "./PhpCgiWorker.mjs"
      },
      "require": {
        "types": "./PhpCgiWorker.d.cts",
        "default": "./PhpCgiWorker.js"
      },
      "default": "./PhpCgiWorker.mjs"
    },
    "./*.mjs": "./*.mjs",
    "./*.js": "./*.js",
    "./*.data": "./*.data",
    "./*.wasm": "./*.wasm",
    "./PhpCgiBase.mjs": {
      "types": "./PhpCgiBase.d.mts",
      "default": "./PhpCgiBase.mjs"
    },
    "./PhpCgiBase.js": {
      "types": "./PhpCgiBase.d.cts",
      "default": "./PhpCgiBase.js"
    },
    "./PhpCgiNode.mjs": {
      "types": "./PhpCgiNode.d.mts",
      "default": "./PhpCgiNode.mjs"
    },
    "./PhpCgiNode.js": {
      "types": "./PhpCgiNode.d.cts",
      "default": "./PhpCgiNode.js"
    },
    "./PhpCgiWeb": {
      "import": {
        "types": "./PhpCgiWeb.d.mts",
        "default": "./PhpCgiWeb.mjs"
      },
      "require": {
        "types": "./PhpCgiWeb.d.cts",
        "default": "./PhpCgiWeb.js"
      },
      "default": "./PhpCgiWeb.mjs"
    },
    "./PhpCgiWeb.mjs": {
      "types": "./PhpCgiWeb.d.mts",
      "default": "./PhpCgiWeb.mjs"
    },
    "./PhpCgiWeb.js": {
      "types": "./PhpCgiWeb.d.cts",
      "default": "./PhpCgiWeb.js"
    },
    "./PhpCgiWebBase.mjs": {
      "types": "./PhpCgiWebBase.d.mts",
      "default": "./PhpCgiWebBase.mjs"
    },
    "./PhpCgiWebBase.js": {
      "types": "./PhpCgiWebBase.d.cts",
      "default": "./PhpCgiWebBase.js"
    },
    "./PhpCgiWebview": {
      "import": {
        "types": "./PhpCgiWebview.d.mts",
        "default": "./PhpCgiWebview.mjs"
      },
      "require": {
        "types": "./PhpCgiWebview.d.cts",
        "default": "./PhpCgiWebview.js"
      },
      "default": "./PhpCgiWebview.mjs"
    },
    "./PhpCgiWebview.mjs": {
      "types": "./PhpCgiWebview.d.mts",
      "default": "./PhpCgiWebview.mjs"
    },
    "./PhpCgiWebview.js": {
      "types": "./PhpCgiWebview.d.cts",
      "default": "./PhpCgiWebview.js"
    },
    "./PhpCgiWorker.mjs": {
      "types": "./PhpCgiWorker.d.mts",
      "default": "./PhpCgiWorker.mjs"
    },
    "./PhpCgiWorker.js": {
      "types": "./PhpCgiWorker.d.cts",
      "default": "./PhpCgiWorker.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seanmorris/php-wasm.git"
  },
  "author": "Sean Morris <php-wasm@seanmorr.is>",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.5.0"
  },
  "contributors": [
    {
      "name": "Sean Morris",
      "email": "php-wasm@seanmorr.is",
      "url": "https://seanmorr.is"
    }
  ],
  "scripts": {
    "postpublish": "ls *.mjs *.js *.wasm *.data | while read FILENAME; do echo -n \"curl -X PURGE $FILENAME ... \";  curl -X PURGE https://cdn.jsdelivr.net/npm/php-cgi-wasm/$FILENAME; echo; done;"
  },
  "keywords": [
    "php",
    "wasm",
    "php-wasm",
    "php-cgi-wasm",
    "vrzno"
  ],
  "files": [
    "*.js",
    "*.mjs",
    "[0-9a-f]*.wasm",
    "*.data",
    "*.d.ts",
    "*.d.mts",
    "LICENSE",
    "NOTICE",
    "README.md",
    "package.json",
    "*.d.cts"
  ]
}
